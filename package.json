{
  "name": "painel-producao-nuvem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "login": "wrangler login",
    "configurar": "node scripts/configurar.mjs",
    "banco:local": "wrangler d1 migrations apply DB --local",
    "banco:remoto": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc --noEmit",
    "test": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.92.0",
    "typescript": "5.9.3",
    "@cloudflare/workers-types": "4.20260515.1"
  }
}
